# Copie ce fichier en « .env » (chmod 600) et ne le versionne jamais.
# Les variables d'environnement du même nom restent prioritaires sur ce fichier.
# Une ligne = CLE=valeur. Pas de commentaire en fin de ligne ; guillemets facultatifs.

# Jeton d'accès (lien ?token=…). S'il est absent, il est généré et écrit ici au premier démarrage.
# BIBLIO_TOKEN=

# Mot de passe demandé pour supprimer un fichier.
# Absent ou vide : la suppression est désactivée.
BIBLIO_PASSWORD=
